# 이 파일을 복사해서 ".env" 파일을 만들고 키를 채워주세요.
#   cp .env.example .env

# Claude(번역·구조화·증류)용 API 키 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 서버 포트
PORT=3000

# (선택) 유튜브 자동 추출용 외부 프록시.
# Render 같은 클라우드 IP를 유튜브가 차단(403/429)할 때, 주거용(residential) 프록시를
# 여기에 넣으면 자막 자동 추출 성공률이 올라갑니다. 없으면 "자막 직접 붙여넣기"로 우회하세요.
#   예: http://사용자:비밀번호@호스트:포트
# YT_PROXY=http://user:pass@host:port

# (선택) 리더 프록시. IP 차단 시 유튜브를 대신 가져와 자막 텍스트로 돌려주는 폴백.
# 기본값은 Jina Reader. 정밀 타임스탬프는 없지만 IP 차단을 피할 수 있습니다.
# READER_PROXY=https://r.jina.ai/
