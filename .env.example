# 이 파일을 복사해서 ".env" 파일을 만들고 키를 채워주세요.
#   cp .env.example .env

# 참고: Anthropic(Claude) API 키는 더 이상 서버에 두지 않습니다.
# Claude 호출은 사용자 브라우저가 본인 키로 api.anthropic.com 에 직접 하며,
# 키는 브라우저(localStorage)에만 저장됩니다(웹 화면 왼쪽 ☰ 에서 입력).

# (선택) 서버 포트
PORT=3000

# (선택) 앱 접근 토큰 — 공개 URL에서 남이 서버 자막 수집(내 Supadata 쿼터)을 함부로
# 못 쓰게 막습니다. 값을 설정하면 /api/transcript·/api/storyboard 호출에 이 토큰이
# 필요해지고, 사용자는 웹 화면 ☰ 에서 같은 값을 입력합니다(브라우저에만 저장).
# 비워두면(기본) 엔드포인트는 공개로 동작합니다(기존과 동일).
# APP_ACCESS_TOKEN=아무거나-길고-무작위한-문자열

# (추천) 자막 추출 전문 API 키 — 링크만으로 자동 추출을 안정화하는 가장 확실한 방법.
# 유튜브가 클라우드 IP를 막아도, 이 서비스가 대신 가져와 타임스탬프 자막을 돌려줍니다.
# 무료 티어: https://supadata.ai 에서 발급
# SUPADATA_API_KEY=sd_...

# (선택) 유튜브 자동 추출용 외부 프록시.
# Render 같은 클라우드 IP를 유튜브가 차단(403/429)할 때, 주거용(residential) 프록시를
# 여기에 넣으면 자막 자동 추출 성공률이 올라갑니다. 없으면 "자막 직접 붙여넣기"로 우회하세요.
#   예: http://사용자:비밀번호@호스트:포트
# YT_PROXY=http://user:pass@host:port

# (선택) 리더 프록시. IP 차단 시 유튜브를 대신 가져와 자막 텍스트로 돌려주는 폴백.
# 기본값은 Jina Reader. 정밀 타임스탬프는 없지만 IP 차단을 피할 수 있습니다.
# READER_PROXY=https://r.jina.ai/

# (선택) Jina 무료 API 키. https://jina.ai 에서 무료로 발급.
# 키를 넣으면 인증 리더가 동작해 유튜브 실제 자막 추출 성공률이 올라갑니다.
# JINA_API_KEY=jina_...
